# Backend API URL — set this to your deployed backend URL in Vercel Environment Variables
# Example: https://your-backend.railway.app/api
REACT_APP_API_URL=http://localhost:5000/api

# Application Settings
REACT_APP_NAME=PhotoshopLite
REACT_APP_VERSION=1.0.0

# Feature Flags
REACT_APP_ENABLE_VIDEO_EDITING=true
REACT_APP_ENABLE_ML_FEATURES=true

# Upload Limits (bytes)
REACT_APP_MAX_IMAGE_SIZE=10485760
REACT_APP_MAX_VIDEO_SIZE=104857600
